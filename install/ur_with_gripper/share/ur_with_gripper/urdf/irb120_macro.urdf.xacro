<?xml version="1.0"?>
<!--
  ABB IRB 120 Robot URDF Macro
  Adapted from IFRA-Cranfield/irb120_PoseEstimation repository
  Original Copyright: IFRA Group, Cranfield University (Apache-2.0 License)

  This version uses irb120_ prefix for all links and joints
-->

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Material definitions -->
  <material name="abb_orange">
    <color rgba="0.7372549 0.3490196 0.1607843 1"/>
  </material>
  <material name="abb_yellow">
    <color rgba="1 1 0 1"/>
  </material>
  <material name="abb_black">
    <color rgba="0.1882353 0.1960784 0.2039216 1"/>
  </material>

  <!-- XACRO-MACRO of ABB-IRB120: -->
  <xacro:macro name="irb120_robot" params="parent *origin simulated:=true">

    <!-- Joint connecting to parent -->
    <joint name="irb120_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="irb120_base_link"/>
    </joint>

    <!-- ***** ABB-IRB120 ROBOT LINKS ***** -->

    <!-- base_link -->
    <link name="irb120_base_link">
      <inertial>
        <mass value="6.215"/>
        <origin xyz="-0.04204 8.01E-05 0.07964" rpy="0 0 0"/>
        <inertia ixx="0.0247272" ixy="-8.0784E-05" ixz="0.00130902" iyy="0.0491285" iyz="-8.0419E-06" izz="0.0472376"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/base_link.dae"/>
        </geometry>
        <material name="abb_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/base_link.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link_1 -->
    <link name="irb120_link_1">
      <inertial>
        <mass value="3.067" />
        <origin xyz="9.77E-05 -0.00012 0.23841" rpy="0 0 0"/>
        <inertia ixx="0.0142175" ixy="-1.28579E-05" ixz="-2.31364E-05" iyy="0.0144041" iyz="1.93404E-05" izz="0.0104533"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/link_1.dae"/>
        </geometry>
        <material name="abb_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/link_1.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link_2 -->
    <link name="irb120_link_2">
      <inertial>
        <mass value="3.909"/>
        <origin xyz="0.00078 -0.00212 0.10124" rpy="0 0 0"/>
        <inertia ixx="0.0603111" ixy="9.83431E-06" ixz="5.72407E-05" iyy="0.041569" iyz="-0.00050497" izz="0.0259548"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/link_2.dae"/>
        </geometry>
        <material name="abb_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/link_2.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link_3 -->
    <link name="irb120_link_3">
      <inertial>
        <mass value="2.944"/>
        <origin xyz="0.02281 0.00106 0.05791" rpy="0 0 0"/>
        <inertia ixx="0.00835606" ixy="-8.01545E-05" ixz="0.00142884" iyy="0.016713" iyz="-0.000182227" izz="0.0126984"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/link_3.dae"/>
        </geometry>
        <material name="abb_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/link_3.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link_4 -->
    <link name="irb120_link_4">
      <inertial>
        <mass value="1.328"/>
        <origin xyz="0.2247 0.00015 0.00041" rpy="0 0 0"/>
        <inertia ixx="0.00284661" ixy="-2.12765E-05" ixz="-1.6435E-05" iyy="0.00401346" iyz="1.31336E-05" izz="0.0052535"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/link_4.dae"/>
        </geometry>
        <material name="abb_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/link_4.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link_5 -->
    <link name="irb120_link_5">
      <inertial>
        <mass value="0.546"/>
        <origin xyz="-0.00109 3.68E-05 6.22E-05" rpy="0 0 0"/>
        <inertia ixx="0.000404891" ixy="1.61943E-06" ixz="8.46805E-07" iyy="0.000892825" iyz="-1.51792E-08" izz="0.000815468"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/link_5.dae"/>
        </geometry>
        <material name="abb_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/link_5.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link_6 -->
    <link name="irb120_link_6">
      <inertial>
        <mass value="0.137"/>
        <origin xyz="-0.00706 -0.00017 -1.32E-06" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/visual/link_6.dae"/>
        </geometry>
        <material name="abb_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ur_with_gripper)/meshes/irb120/collision/link_6.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- ***** ABB-IRB120 ROBOT JOINTS ***** -->

    <!-- joint_1 -->
    <joint name="irb120_joint_1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="irb120_base_link"/>
      <child link="irb120_link_1"/>
      <limit effort="1000" lower="-2.87979" upper="2.87979" velocity="4.36332"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="50.0" friction="1.0"/>
    </joint>

    <!-- joint_2 -->
    <joint name="irb120_joint_2" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.29"/>
      <parent link="irb120_link_1"/>
      <child link="irb120_link_2"/>
      <limit effort="1000" lower="-1.91986" upper="1.91986" velocity="4.36332"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="50.0" friction="1.0"/>
    </joint>

    <!-- joint_3 -->
    <joint name="irb120_joint_3" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.27"/>
      <parent link="irb120_link_2"/>
      <child link="irb120_link_3"/>
      <limit effort="1000" lower="-1.91986" upper="1.22173" velocity="4.36332"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="10.0" friction="1.0"/>
    </joint>

    <!-- joint_4 -->
    <joint name="irb120_joint_4" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.07"/>
      <parent link="irb120_link_3"/>
      <child link="irb120_link_4"/>
      <limit effort="1000" lower="-2.79253" upper="2.79253" velocity="5.58505"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!-- joint_5 -->
    <joint name="irb120_joint_5" type="revolute">
      <origin rpy="0 0 0" xyz="0.302 0 0"/>
      <parent link="irb120_link_4"/>
      <child link="irb120_link_5"/>
      <limit effort="1000" lower="-2.00" upper="2.00" velocity="5.58505"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="2.0" friction="1.0"/>
    </joint>

    <!-- joint_6 -->
    <joint name="irb120_joint_6" type="revolute">
      <origin rpy="0 0 0" xyz="0.072 0 0"/>
      <parent link="irb120_link_5"/>
      <child link="irb120_link_6"/>
      <limit effort="1000" lower="-6.98132" upper="6.98132" velocity="7.33038"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="1.0" friction="1.0"/>
    </joint>

    <!-- ***** STANDARD FRAMES ***** -->

    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <link name="irb120_flange"/>
    <joint type="fixed" name="irb120_joint_6-flange">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="irb120_link_6"/>
      <child link="irb120_flange"/>
    </joint>

    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <link name="irb120_tool0" />
    <joint name="irb120_flange-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <parent link="irb120_flange" />
      <child link="irb120_tool0" />
    </joint>

    <!-- Gazebo self-collision settings -->
    <gazebo reference="irb120_base_link">
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="irb120_link_1">
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="irb120_link_2">
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="irb120_link_3">
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="irb120_link_4">
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="irb120_link_5">
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="irb120_link_6">
      <selfCollide>false</selfCollide>
    </gazebo>

  </xacro:macro>
</robot>
