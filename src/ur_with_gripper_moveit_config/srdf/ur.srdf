<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur">
  <group name="ur10e_arm">
    <chain base_link="ur10e_base_link" tip_link="ur10e_tool0" />
  </group>
  <group name="gripper">
    <link name="left_finger" />
    <link name="right_finger" />
    <joint name="left_finger_joint" />
  </group>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="-0.045" />
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0" />
  </group_state>
  <group_state name="up" group="ur10e_arm">
    <joint name="ur10e_elbow_joint" value="0" />
    <joint name="ur10e_shoulder_lift_joint" value="-1.5704" />
    <joint name="ur10e_shoulder_pan_joint" value="0" />
    <joint name="ur10e_wrist_1_joint" value="0" />
    <joint name="ur10e_wrist_2_joint" value="0" />
    <joint name="ur10e_wrist_3_joint" value="0" />
  </group_state>
  <end_effector name="custom_gripper" parent_link="ur10e_tool0" group="gripper" />
  <passive_joint name="right_finger_joint" />
  <disable_collisions link1="gripper_base" link2="left_finger" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="right_finger" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="ur10e_wrist_1_link" reason="Never" />
  <disable_collisions link1="gripper_base" link2="ur10e_wrist_2_link" reason="Never" />
  <disable_collisions link1="gripper_base" link2="ur10e_wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="left_finger" link2="right_finger" reason="Never" />
  <disable_collisions link1="left_finger" link2="ur10e_wrist_1_link" reason="Never" />
  <disable_collisions link1="left_finger" link2="ur10e_wrist_2_link" reason="Never" />
  <disable_collisions link1="left_finger" link2="ur10e_wrist_3_link" reason="Never" />
  <disable_collisions link1="right_finger" link2="ur10e_wrist_1_link" reason="Never" />
  <disable_collisions link1="right_finger" link2="ur10e_wrist_2_link" reason="Never" />
  <disable_collisions link1="right_finger" link2="ur10e_wrist_3_link" reason="Never" />
  <disable_collisions link1="ur10e_base_link_inertia" link2="ur10e_shoulder_link" reason="Adjacent" />
  <disable_collisions link1="ur10e_base_link_inertia" link2="ur10e_upper_arm_link" reason="Never" />
  <disable_collisions link1="ur10e_base_link_inertia" link2="ur10e_wrist_1_link" reason="Never" />
  <disable_collisions link1="ur10e_forearm_link" link2="ur10e_upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="ur10e_forearm_link" link2="ur10e_wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="ur10e_shoulder_link" link2="ur10e_upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="ur10e_shoulder_link" link2="ur10e_wrist_1_link" reason="Never" />
  <disable_collisions link1="ur10e_wrist_1_link" link2="ur10e_wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="ur10e_wrist_1_link" link2="ur10e_wrist_3_link" reason="Never" />
  <disable_collisions link1="ur10e_wrist_2_link" link2="ur10e_wrist_3_link" reason="Adjacent" />
</robot>
