            </Attribute>
            <Attribute Name="CollisionHeight" Unit="m">
                <Value>0.020</Value>
            </Attribute>
        </InternalElement>

        <InternalElement Name="Klemme4">
            <Attribute Name="Anzahl">
                <Value>4</Value>
            </Attribute>
            <Attribute Name="GrippingPosition" Unit="m">
                <Value>0.318216,-0.132996,0.163930</Value>
            </Attribute>
            <Attribute Name="GrippingXOffset" Unit="m">
                <Value>0.049</Value>
            </Attribute>
            <Attribute Name="CollisionHeight" Unit="m">
                <Value>0.020</Value>
            </Attribute>
        </InternalElement>

        <InternalElement Name="Klemme5">
            <Attribute Name="Anzahl">
                <Value>3</Value>
            </Attribute>
            <Attribute Name="GrippingPosition" Unit="m">
                <Value>0.264566,-0.083457,0.198637</Value>
