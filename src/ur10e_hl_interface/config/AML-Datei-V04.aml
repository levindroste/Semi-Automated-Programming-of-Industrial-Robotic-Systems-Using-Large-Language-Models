  <InstanceHierarchy Name="Roboter-Parameter" ID="robot-params">
    <Version>1.0.0</Version>
    <InternalElement Name="Greif-Parameter" ID="grasp-params">
      <Attribute Name="Approach-Höhe" AttributeDataType="xs:double" Unit="mm">
        <Value>100</Value>
      </Attribute>
      <Attribute Name="Place-Höhen-Offset" AttributeDataType="xs:double" Unit="mm">
        <Value>0</Value>
      </Attribute>
      <!-- GLOBALER Abstand zwischen gleichen Komponenten im Lager -->
