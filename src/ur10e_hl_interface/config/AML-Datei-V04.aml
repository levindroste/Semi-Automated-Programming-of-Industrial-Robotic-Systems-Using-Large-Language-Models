        <Value>150</Value>
      </Attribute>
      <Attribute Name="Objekt-Spacing-auf-Schiene" AttributeDataType="xs:double" Unit="mm">
        <Value>10</Value>
      </Attribute>
      <!-- Globale Standard-Orientierungen für alle Klemmen -->
      <Attribute Name="Standard-Pick-Orientierung" AttributeDataType="xs:string" Unit="quaternion">
        <Value>1.0,0.0,0.0,0.0</Value>
      </Attribute>
      <Attribute Name="Standard-Place-Orientierung" AttributeDataType="xs:string" Unit="quaternion">
        <Value>0.0,0.0,0.707,0.707</Value>
      </Attribute>
    </InternalElement>
    <InternalElement Name="Schaltschrank-Parameter" ID="cabinet-params">
      <Attribute Name="Basis-Position-X" AttributeDataType="xs:double" Unit="m">
        <Value>-0.942</Value>
      </Attribute>
      <Attribute Name="Basis-Position-Y" AttributeDataType="xs:double" Unit="m">
        <Value>-0.433</Value>
      </Attribute>
      <Attribute Name="Basis-Position-Z" AttributeDataType="xs:double" Unit="m">
        <Value>0.3</Value>
      </Attribute>
      <Attribute Name="Schienen-Abstand" AttributeDataType="xs:double" Unit="m">
        <Value>0.18</Value>
      </Attribute>
      <!-- GLOBALER Abstand zwischen Hutschienen im Lager -->
